import { Icon } from "@/lib/icons"
import { navGroups, type NavItem } from "@/lib/navs"
import { Atom, Clock, Leap, Ripple, Trace } from "@/components/loaders";
import type {OctaneNode} from 'octane'
import Button from "@/ui/Button.btsx";

module
  export interface PageHolderProps {
    href: string
    id: number
    children?: OctaneNode
  }

props { href, id, children }: PageHolderProps
setup
  const item: NavItem | undefined = navGroups.flatMap((group) => group.items).find((navItem) => navItem.href === href)
  const Loader = () => {
    switch (id) {
      case 0:
        return Atom
      case 1:
        return Clock
      case 2:
        return Ripple
      case 3:
        return Trace
      default:
        return Leap
    }
  }
section(className="flex flex-col gap-6 bg-surface")
  header(className="flex items-center h-13 bg-mist-400/20 gap-2 px-5")
    if item
      div(className="flex h-full items-center justify-center")
        Icon(name={item.icon} size={24} className="text-muted-foreground")
    div(className='flex items-center gap-8')
      h1(className="text-xl font-sans font-bold tracking-tight") #{item?.label ?? href}
      Button(size='lg' className='brightness-106') Press Me
  div(className="flex flex-1 items-center justify-center")
    Loader
  fragment
    | #{children}
